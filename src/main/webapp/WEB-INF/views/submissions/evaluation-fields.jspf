<%@ page pageEncoding="UTF-8" %>
<%
    String gradingKey = gradingTaskOrder + "_" + gradingRequirement.order();
    String gradingScoreName = "score_" + gradingKey;
    String gradingFeedbackName = "requirementFeedback_" + gradingKey;
    String gradingAiName = "ai_" + gradingKey;
    SubmissionEvaluation.Mark gradingMark = evaluation.mark(gradingTaskOrder, gradingRequirement.order());
    String gradingSavedScore = gradingMark == null || gradingMark.score() == null ? "" : gradingMark.score().stripTrailingZeros().toPlainString();
    String gradingScore = evaluationValue(request, gradingScoreName, gradingSavedScore);
    String gradingFeedback = evaluationValue(request, gradingFeedbackName, gradingMark == null ? "" : gradingMark.feedback());
    String gradingAi = evaluationValue(request, gradingAiName, String.valueOf(gradingMark != null && gradingMark.aiGenerated()));
%>
<div class="requirement-evaluation">
    <% if (evaluationEditable) { %>
        <label for="<%= gradingScoreName %>">Điểm</label>
        <div class="evaluation-score-control">
            <input id="<%= gradingScoreName %>" name="<%= gradingScoreName %>" form="evaluation-form" type="text"
                inputmode="decimal" autocomplete="off" pattern="[0-9]{1,3}(\.[0-9]{1,2})?"
                value="<%= escape(gradingScore) %>" data-evaluation-score data-key="<%= gradingKey %>"
                data-saved-value="<%= escape(gradingSavedScore) %>"
                data-maximum="<%= gradingRequirement.points().toPlainString() %>">
            <span>/ <%= escape(TeacherSubmissionView.score(gradingRequirement.points())) %></span>
        </div>
        <small>Để trống khi chưa chấm. Có thể cho điểm 0.</small>
        <label for="<%= gradingFeedbackName %>">Nhận xét</label>
        <textarea id="<%= gradingFeedbackName %>" name="<%= gradingFeedbackName %>" form="evaluation-form" rows="5"
            maxlength="2000" data-ai-feedback="<%= gradingAiName %>" data-saved-value="<%= escape(gradingMark == null ? "" : gradingMark.feedback()) %>" class="<%= gradingAi.equals("true") ? "ai-feedback" : "" %>"><%= escape(gradingFeedback) %></textarea>
        <input type="hidden" name="<%= gradingAiName %>" form="evaluation-form" value="<%= escape(gradingAi) %>" data-saved-value="<%= gradingMark != null && gradingMark.aiGenerated() %>">
        <span class="ai-feedback-label" data-ai-label="<%= gradingAiName %>" <%= gradingAi.equals("true") ? "" : "hidden" %>>Nhận xét do AI viết</span>
    <% } else { %>
        <dl class="evaluation-readonly">
            <dt>Điểm</dt><dd><%= gradingSavedScore.isEmpty() ? "Chưa chấm" : escape(gradingSavedScore) %> / <%= escape(TeacherSubmissionView.score(gradingRequirement.points())) %></dd>
            <dt>Nhận xét</dt><dd class="content-text <%= gradingMark != null && gradingMark.aiGenerated() ? "ai-feedback" : "" %>"><%= escape(gradingFeedback.isBlank() ? "Chưa có nhận xét." : gradingFeedback) %></dd>
        </dl>
    <% } %>
</div>
