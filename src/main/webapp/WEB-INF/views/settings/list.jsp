<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,vn.edu.fpt.ams.model.*,vn.edu.fpt.ams.util.WebSupport" %>
<% var terms=(List<AcademicTerm>)request.getAttribute("terms"); String keyword=request.getParameter("keyword"); String status=request.getParameter("status"); String token=WebSupport.csrf(request); boolean hasActiveTerm=Boolean.TRUE.equals(request.getAttribute("hasActiveTerm")); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Danh sách học kỳ | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"><%@ include file="/WEB-INF/views/shared/assets.jspf" %></head><body class="admin-users admin-app admin-settings ams-ui">
<%@ include file="/WEB-INF/views/admin/shell.jspf" %>
<main class="users-main ams-content" id="page-content">
<nav class="bao-context" aria-label="Ngữ cảnh"><span>Cài đặt</span><span aria-hidden="true">›</span><span>Học kỳ</span></nav>
<div class="setting-page-heading"><p class="page-eyebrow">QUẢN TRỊ HỌC THUẬT</p><h1>Danh sách học kỳ</h1><p class="muted">Quản lý danh sách học kỳ, xem, tìm kiếm, lọc, thêm mới và quản lý trạng thái học kỳ.</p></div>
<section class="setting-list-card">
<p class="muted filter-scope-note">Bộ lọc này chỉ áp dụng cho học kỳ.</p>
<div class="users-toolbar"><form method="get" action="${pageContext.request.contextPath}/admin/settings"><input type="hidden" name="tab" value="terms"><label>Tìm học kỳ<input name="keyword" maxlength="50" value="<%=WebSupport.html(keyword)%>" placeholder="Mã hoặc tên học kỳ…"></label><label>Trạng thái học kỳ<select name="status"><option value="">Tất cả trạng thái học kỳ</option><option value="ACTIVE" <%="ACTIVE".equals(status)?"selected":""%>>Hoạt động</option><option value="INACTIVE" <%="INACTIVE".equals(status)?"selected":""%>>Ngừng hoạt động</option></select></label><button>Tìm kiếm</button></form><a class="primary-button" href="${pageContext.request.contextPath}/admin/master-data?mode=create">+ Thêm học kỳ</a></div>
<% if("1".equals(request.getParameter("saved"))){ %><p role="status">Đã cập nhật học kỳ.</p><% } %>
<% if(request.getAttribute("error")!=null){ %><p role="alert"><%=WebSupport.html(request.getAttribute("error"))%></p><% } %>
<div class="users-table-wrap"><table class="setting-records"><thead><tr><th>#</th><th>Mã học kỳ</th><th>Tên học kỳ</th><th>Ngày bắt đầu</th><th>Ngày kết thúc</th><th>Hiện tại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
<% if(terms==null||terms.isEmpty()){ %><tr><td colspan="8" class="empty-state">Không có học kỳ phù hợp.</td></tr><% } else {int rowNumber=0; for(var term:terms){ %>
<tr><td><%=++rowNumber%></td><td><strong><%=WebSupport.html(term.termCode())%></strong></td><td><%=WebSupport.html(term.termName())%></td><td><%=term.startsAt().atZone(java.time.ZoneOffset.UTC).toLocalDate()%></td><td><%=term.endsAt().atZone(java.time.ZoneOffset.UTC).toLocalDate()%></td><td><span class="term-current-badge <%=term.current()?"current":""%>"><%=term.current()?"Hiện tại":"—"%></span></td><td><span class="status-badge <%=term.active()?"active":"inactive"%>"><%=term.active()?"Đang hoạt động":"Ngừng hoạt động"%></span></td><td><div class="row-actions"><a href="${pageContext.request.contextPath}/admin/master-data?mode=view&id=<%=term.termId()%>">Xem</a><a href="${pageContext.request.contextPath}/admin/master-data?mode=edit&id=<%=term.termId()%>">Sửa</a><% if(term.active()&&!term.current()){ %><form method="post" action="${pageContext.request.contextPath}/admin/master-data"><input type="hidden" name="csrf" value="<%=WebSupport.html(session.getAttribute("csrf"))%>"><input type="hidden" name="action" value="current"><input type="hidden" name="termId" value="<%=term.termId()%>"><button>Đặt hiện tại</button></form><% } %><% if(term.current()){ %><span class="muted">Chuyển học kỳ để ngừng</span><% }else if(!term.active()&&hasActiveTerm){ %><a href="${pageContext.request.contextPath}/admin/master-data?mode=switch&amp;id=<%=term.termId()%>">Chuyển học kỳ</a><% }else{ %><form method="post" action="${pageContext.request.contextPath}/admin/master-data"><input type="hidden" name="csrf" value="<%=WebSupport.html(session.getAttribute("csrf"))%>"><input type="hidden" name="action" value="status"><input type="hidden" name="termId" value="<%=term.termId()%>"><input type="hidden" name="active" value="<%=!term.active()%>"><button class="<%=term.active()?"destructive-link":""%>"><%=term.active()?"Ngừng hoạt động":"Kích hoạt"%></button></form><% } %></div></td></tr>
<% } } %></tbody></table></div><p class="bao-record-count">Tổng cộng <%=terms==null?0:terms.size()%> học kỳ</p>
</section></main></div></body></html>
