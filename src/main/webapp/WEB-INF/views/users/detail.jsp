<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,vn.edu.fpt.ams.model.*,vn.edu.fpt.ams.util.WebSupport" %>
<% var u=(UserAccount)request.getAttribute("user"); boolean create=u==null; boolean read="view".equals(request.getAttribute("mode")); var subjects=(Map<Long,String>)request.getAttribute("subjects"); var eligible=(Set<Long>)request.getAttribute("eligibility"); if(eligible==null)eligible=Set.of(); String token=WebSupport.csrf(request); boolean submitted=Boolean.TRUE.equals(request.getAttribute("submitted")); String name=submitted?request.getParameter("fullName"):create?"":u.fullName(); String email=submitted?request.getParameter("email"):create?"":u.email(); String role=submitted?request.getParameter("role"):create?"TEACHER":u.role().name(); if(submitted)eligible=WebSupport.ids(request.getParameterValues("subjects")); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Chi tiết tài khoản | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body><main><%@ include file="../auth/session-nav.jspf" %><nav><a href="${pageContext.request.contextPath}/admin/users">Tài khoản</a></nav><h1><%=create?"Tạo tài khoản nội bộ":"Chi tiết tài khoản"%></h1>
<% if(session.getAttribute("notice")!=null){ %><p role="status"><%=WebSupport.html(vn.edu.fpt.ams.util.Vietnamese.label(session.getAttribute("notice")))%></p><% session.removeAttribute("notice"); } if(request.getAttribute("error")!=null){ %><p role="alert"><%=WebSupport.html(vn.edu.fpt.ams.util.Vietnamese.label(request.getAttribute("error")))%></p><% } %>
<% if(!create){ %><p>Tài khoản #<%=u.userId()%> · <%=vn.edu.fpt.ams.util.Vietnamese.label(u.accountStatus())%> · Đăng nhập gần nhất: <%=u.lastLoginAt()==null?"Chưa từng":WebSupport.html(u.lastLoginAt())%></p><% } %>
<form method="post"><input type="hidden" name="csrf" value="<%=token%>"><input type="hidden" name="action" value="<%=create?"create":"update"%>"><% if(!create){ %><input type="hidden" name="id" value="<%=u.userId()%>"><% } %>
<label>Họ tên <input name="fullName" maxlength="50" required value="<%=WebSupport.html(name)%>" <%=read?"readonly":""%>></label>
<label>Email <input type="email" name="email" maxlength="100" required value="<%=WebSupport.html(email)%>" <%=read||!create&&u.role()==UserRole.STUDENT?"readonly":""%>></label>
<label>Vai trò <select name="role" <%=read?"disabled":""%>><% if(!create&&u.role()==UserRole.STUDENT){ %><option value="STUDENT">Sinh viên</option><% } else for(var r:List.of(UserRole.ADMIN,UserRole.EXPERT,UserRole.TEACHER)){ %><option value="<%=r.name()%>" <%=r.name().equals(role)?"selected":""%>><%=vn.edu.fpt.ams.util.Vietnamese.label(r)%></option><% } %></select></label>
<fieldset><legend>Điều kiện giảng dạy</legend><p>Chỉ chọn môn cho giảng viên. Không thể bỏ điều kiện giảng dạy khi đang phụ trách lớp hoạt động.</p><% for(var s:subjects.entrySet()){ %><label class="check"><input type="checkbox" name="subjects" value="<%=s.getKey()%>" <%=eligible.contains(s.getKey())?"checked":""%> <%=read?"disabled":""%>><%=WebSupport.html(s.getValue())%></label><% } %></fieldset>
<% if(!read){ %><button><%=create?"Tạo và gửi thông tin đăng nhập":"Lưu thay đổi"%></button><% } %></form>
<% if(!create){ if(read){ %><p><a href="?mode=edit&amp;id=<%=u.userId()%>">Sửa tài khoản</a></p><% } else { %>
<form method="post"><input type="hidden" name="csrf" value="<%=token%>"><input type="hidden" name="id" value="<%=u.userId()%>"><input type="hidden" name="action" value="status"><input type="hidden" name="status" value="<%=u.accountStatus()==AccountStatus.ACTIVE?"INACTIVE":"ACTIVE"%>"><p>Vô hiệu hóa sẽ kết thúc phân công và hủy đề nghị còn hạn. Kích hoạt lại không tự khôi phục các phân công.</p><label class="check"><input type="checkbox" required>Xác nhận thay đổi trạng thái tài khoản</label><button><%=u.accountStatus()==AccountStatus.ACTIVE?"Vô hiệu hóa":"Kích hoạt lại"%></button></form>
<% if(u.role()!=UserRole.STUDENT&&u.accountStatus()==AccountStatus.ACTIVE){ %><form method="post"><input type="hidden" name="csrf" value="<%=token%>"><input type="hidden" name="id" value="<%=u.userId()%>"><input type="hidden" name="action" value="credential"><p>Cấp lại sẽ thay mật khẩu hiện tại và gửi thông tin đăng nhập mới qua email.</p><label class="check"><input type="checkbox" required>Xác nhận thay mật khẩu</label><button>Cấp lại mật khẩu</button></form><% } } } %>
</main></body></html>
