<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,java.time.*,java.time.format.*,vn.edu.fpt.ams.dto.*,vn.edu.fpt.ams.model.*,vn.edu.fpt.ams.util.WebSupport,vn.edu.fpt.ams.util.Vietnamese" %>
<% var templates=(List<ExpertTemplateDTO>)request.getAttribute("templates"); var subjects=(List<AssignedSubjectDTO>)request.getAttribute("subjects"); String selected=request.getParameter("subjectId"); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mẫu bài tập | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body class="expert-app">
<%@ include file="/WEB-INF/views/expert/shell.jspf" %>
<header class="expert-page-heading"><h1>Mẫu bài tập</h1><p>Xem mẫu thuộc các môn học bạn đang có trách nhiệm Chuyên gia chính hoặc Chuyên gia hỗ trợ.</p></header>
<form class="expert-template-filter" method="get" id="template-filter"><label>Môn học<select name="subjectId" onchange="this.form.submit()"><option value="">Tất cả môn học</option><% if(subjects!=null)for(var subject:subjects){ %><option value="<%=subject.subjectId()%>" <%=String.valueOf(subject.subjectId()).equals(selected)?"selected":""%>><%=WebSupport.html(subject.subjectCode())%> — <%=WebSupport.html(subject.subjectName())%></option><% } %></select></label></form>
<div class="expert-table-wrap"><table class="expert-table"><thead><tr><th>Tiêu đề</th><th>Môn học</th><th>Điểm tối đa</th><th>Trạng thái</th><th>Cập nhật lần cuối</th></tr></thead><tbody><% if(templates==null||templates.isEmpty()){ %><tr><td colspan="5" class="empty-state">Chưa có mẫu bài tập cho môn học này.</td></tr><% } else { var date=DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm").withZone(ZoneId.of("Asia/Ho_Chi_Minh")); for(var item:templates){ %><tr><td><strong><%=WebSupport.html(item.title())%></strong></td><td><strong><%=WebSupport.html(item.subjectCode())%></strong><br><small><%=WebSupport.html(item.subjectName())%></small></td><td><%=item.maximumScore()%></td><td><span class="status-badge <%=item.status().name().toLowerCase()%>"><%=Vietnamese.label(item.status())%></span></td><td><%=item.updatedAt()==null?"—":date.format(item.updatedAt())%></td></tr><% }} %></tbody></table></div>
<p class="expert-result-count">Hiển thị <%=templates==null?0:templates.size()%> mẫu bài tập</p>
</main></div></body></html>
