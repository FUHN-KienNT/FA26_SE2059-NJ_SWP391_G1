<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,java.time.*,java.time.format.*,vn.edu.fpt.ams.dto.*,vn.edu.fpt.ams.model.*,vn.edu.fpt.ams.util.WebSupport" %>
<% var details=(SubjectDetailsDTO)request.getAttribute("details");var s=details.subject();var terms=(List<AcademicTerm>)request.getAttribute("eligibleTerms");String base=request.getContextPath()+"/admin/subjects",token=WebSupport.csrf(request);var date=DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm").withZone(ZoneId.of("Asia/Ho_Chi_Minh")); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mở môn theo học kỳ | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body class="admin-users admin-subjects">
<header class="admin-top"><a href="${pageContext.request.contextPath}/admin/dashboard">AMS · Quản trị hệ thống</a><form method="post" action="${pageContext.request.contextPath}/auth/signout"><span>Quản trị viên</span><input type="hidden" name="csrf" value="<%=token%>"><button>Đăng xuất</button></form></header>
<div class="admin-layout"><aside class="admin-sidebar"><nav><a href="${pageContext.request.contextPath}/admin/dashboard">Bảng điều khiển</a><a href="${pageContext.request.contextPath}/admin/users">Tài khoản</a><a href="<%=base%>" aria-current="page">Môn học</a><a href="${pageContext.request.contextPath}/admin/settings">Cài đặt</a></nav></aside><main class="users-main subject-form">
<p><a href="<%=base%>?mode=view&amp;id=<%=s.subjectId()%>">← Chi tiết môn học</a></p><h1>UC17 · Mở môn theo học kỳ</h1><p><strong><%=WebSupport.html(s.subjectCode()+" · "+s.subjectName())%></strong> · <%=s.status()%></p>
<% if(request.getAttribute("error")!=null){ %><p role="alert"><%=WebSupport.html(request.getAttribute("error"))%></p><% }if(session.getAttribute("notice")!=null){ %><p role="status"><%=WebSupport.html(session.getAttribute("notice"))%></p><% session.removeAttribute("notice"); } %>
<% if(s.status()==SubjectStatus.ACTIVE){ %><form method="post" action="<%=base%>"><input type="hidden" name="csrf" value="<%=token%>"><input type="hidden" name="action" value="term"><input type="hidden" name="id" value="<%=s.subjectId()%>"><label>Học kỳ <select name="termId" required><option value="">Chọn học kỳ</option><% for(var term:terms){ %><option value="<%=term.termId()%>" <%=String.valueOf(term.termId()).equals(request.getParameter("termId"))?"selected":""%>><%=WebSupport.html(term.termCode()+" · "+term.termName())%></option><% } %></select></label><div class="form-grid"><label>Mở đăng ký <input type="datetime-local" name="registrationOpensAt" required value="<%=WebSupport.html(request.getParameter("registrationOpensAt"))%>"></label><label>Đóng đăng ký <input type="datetime-local" name="registrationClosesAt" required value="<%=WebSupport.html(request.getParameter("registrationClosesAt"))%>"></label></div><label class="check"><input type="checkbox" name="registrationEnabled" value="true" <%=request.getParameter("registrationEnabled")!=null?"checked":""%>> Cho phép đăng ký</label><button class="primary-button">Lưu cấu hình</button></form><% }else{ %><p role="alert">Chỉ môn học đang hoạt động mới được mở theo học kỳ.</p><% } %>
<section><h2>Cấu hình hiện tại</h2><div class="users-table-wrap"><table><thead><tr><th>Học kỳ</th><th>Mở đăng ký</th><th>Đóng đăng ký</th><th>Cho phép</th><th>Trạng thái</th></tr></thead><tbody><% for(var term:details.subjectTerms()){ %><tr><td><%=WebSupport.html(term.termCode()+" · "+term.termName())%></td><td><%=date.format(term.registrationOpensAt())%></td><td><%=date.format(term.registrationClosesAt())%></td><td><%=term.registrationEnabled()?"Có":"Không"%></td><td><%=WebSupport.html(term.registrationStatus())%></td></tr><% }if(details.subjectTerms().isEmpty()){ %><tr><td colspan="5" class="empty-state">Chưa có cấu hình học kỳ.</td></tr><% } %></tbody></table></div></section>
</main></div></body></html>
