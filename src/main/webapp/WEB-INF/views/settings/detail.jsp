<%@ page contentType="text/html;charset=UTF-8" import="vn.edu.fpt.ams.model.SystemSetting,vn.edu.fpt.ams.util.WebSupport" %>
<% SystemSetting setting=(SystemSetting)request.getAttribute("setting"); boolean edit="edit".equals(request.getAttribute("mode")); boolean submitted=Boolean.TRUE.equals(request.getAttribute("submitted")); String name=submitted?request.getParameter("name"):setting.name(),priority=submitted?request.getParameter("priority"):String.valueOf(setting.priority()); String base=request.getContextPath()+"/admin/settings"; %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=edit?"Sửa":"Chi tiết"%> thiết lập | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"><%@ include file="/WEB-INF/views/shared/assets.jspf" %></head><body class="admin-users admin-app admin-system-settings ams-ui">
<%@ include file="/WEB-INF/views/admin/shell.jspf" %>
<main class="users-main subject-form ams-content bao-mode-page" id="page-content">
<nav class="bao-context" aria-label="Ngữ cảnh"><a href="<%=base%>">Cài đặt hệ thống</a><span aria-hidden="true">›</span><span><%=edit?"Sửa thiết lập":"Chi tiết thiết lập"%></span></nav>
<div class="subject-heading"><div><h1><%=edit?"Sửa thiết lập":"Chi tiết thiết lập"%></h1><p class="muted">Giá trị và loại là định danh hệ thống, không thể đổi tại đây.</p></div><a class="secondary-button" href="<%=base%>">← Quay lại danh sách</a></div>
<% if(request.getAttribute("error")!=null){ %><p role="alert"><%=WebSupport.html(request.getAttribute("error"))%></p><% } %><% if("1".equals(request.getParameter("saved"))){ %><p role="status">Đã lưu thiết lập.</p><% } %>
<section class="bao-card"><h2>Thông tin thiết lập</h2><dl class="bao-detail-rows"><div><dt>Loại</dt><dd><%=WebSupport.html(setting.type().label())%></dd></div><div><dt>Giá trị</dt><dd><code><%=WebSupport.html(setting.value())%></code></dd></div><div><dt>Trạng thái</dt><dd><span class="status-badge <%=setting.active()?"active":"inactive"%>"><%=setting.active()?"Đang hoạt động":"Ngừng hoạt động"%></span></dd></div></dl></section>
<% if(edit){ %>
<form class="bao-focused-form" method="post" action="<%=base%>"><input type="hidden" name="csrf" value="<%=WebSupport.html(WebSupport.csrf(request))%>"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="<%=setting.settingId()%>"><section class="bao-card"><h2>Thông tin được sửa</h2><div class="form-grid"><label>Tên hiển thị <input name="name" maxlength="100" required value="<%=WebSupport.html(name)%>"></label><label>Ưu tiên <input type="number" name="priority" min="1" max="9999" required value="<%=WebSupport.html(priority)%>"></label></div></section><div class="form-actions"><a class="secondary-button" href="<%=base%>?mode=view&amp;id=<%=setting.settingId()%>">Hủy</a><button class="primary-button">Lưu thay đổi</button></div></form>
<% }else{ %>
<section class="bao-card"><h2>Hiển thị</h2><dl class="bao-detail-rows"><div><dt>Tên</dt><dd><%=WebSupport.html(setting.name())%></dd></div><div><dt>Ưu tiên</dt><dd><%=setting.priority()%></dd></div></dl><p class="muted">Ưu tiên thấp hơn sẽ hiển thị trước trong danh sách lựa chọn.</p></section>
<div class="form-actions"><a class="secondary-button" href="<%=base%>?mode=edit&amp;id=<%=setting.settingId()%>">Sửa tên và ưu tiên</a><form method="post" action="<%=base%>"><input type="hidden" name="csrf" value="<%=WebSupport.html(WebSupport.csrf(request))%>"><input type="hidden" name="action" value="status"><input type="hidden" name="id" value="<%=setting.settingId()%>"><input type="hidden" name="active" value="<%=!setting.active()%>"><label class="check"><input type="checkbox" required> Xác nhận thay đổi trạng thái</label><button class="<%=setting.active()?"secondary-button destructive-link":"primary-button"%>"><%=setting.active()?"Vô hiệu hóa":"Kích hoạt"%></button></form></div>
<% } %>
</main></div></body></html>
