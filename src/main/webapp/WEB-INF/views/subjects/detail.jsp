<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html><head><title>Subject Details | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body><main>
<nav><a href="${pageContext.request.contextPath}/admin/subjects">Subject List</a></nav><h1>Subject Details</h1><p>Mode: ${mode}. This page supports Subject Creation, Subject Update, Subject Expert Assignment, Subject Status Management and Subject Term Setup.</p>
<form action="${pageContext.request.contextPath}/admin/subjects" method="post"><input type="hidden" name="action" value="save"><label>Subject ID <input type="number" name="subjectId"></label><label>Code <input name="subjectCode" required></label><label>Name <input name="subjectName" required></label><label>Description <textarea name="description"></textarea></label><label>Expert IDs <input name="expertIds"></label><label>Academic Term ID <input type="number" name="termId"></label><label>Registration opens <input type="datetime-local" name="registrationOpensAt"></label><label>Registration closes <input type="datetime-local" name="registrationClosesAt"></label><button>Save Subject Details</button></form>
</main></body></html>
