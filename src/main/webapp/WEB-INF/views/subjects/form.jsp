<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,vn.edu.fpt.ams.dto.*,vn.edu.fpt.ams.model.*,vn.edu.fpt.ams.util.WebSupport" %>
<% String mode=(String)request.getAttribute("mode"),base=request.getContextPath()+"/admin/subjects",token=WebSupport.csrf(request);boolean create="create".equals(mode),submitted=Boolean.TRUE.equals(request.getAttribute("submitted"));SubjectDetailsDTO details=(SubjectDetailsDTO)request.getAttribute("details");SubjectDTO s=create?null:details.subject();var eligible=(List<ExpertOptionDTO>)request.getAttribute("eligibleExperts");if(eligible==null)eligible=List.of();Set<Long> primary=submitted?WebSupport.ids(request.getParameterValues("primaryExperts")):Set.of(),supporting=submitted?WebSupport.ids(request.getParameterValues("supportingExperts")):Set.of();String code=submitted?request.getParameter("subjectCode"):(create?"":s.subjectCode()),name=submitted?request.getParameter("subjectName"):(create?"":s.subjectName()),description=submitted?request.getParameter("description"):(create?"":s.description()); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=create?"Thêm":"Cập nhật"%> môn học | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"><%@ include file="/WEB-INF/views/shared/assets.jspf" %></head><body class="admin-users admin-app admin-subjects ams-ui">
<%@ include file="/WEB-INF/views/admin/shell.jspf" %>
<main class="users-main subject-form ams-content bao-mode-page" id="page-content">
<nav class="bao-context" aria-label="Ngữ cảnh"><span>Cài đặt</span><span aria-hidden="true">›</span><span>Môn học</span><span aria-hidden="true">›</span><span><%=create?"Thêm môn học":"Chỉnh sửa"%></span></nav>
<div class="subject-heading"><div><h1><%=create?"Thêm môn học":"Cập nhật môn học"%></h1><p class="muted"><%=create?"Tạo mới môn học trong hệ thống.":"Chỉnh sửa thông tin môn học."%></p></div><a class="secondary-button" href="<%=create?base:base+"?mode=view&id="+s.subjectId()%>">← <%=create?"Quay lại danh sách":"Quay lại chi tiết"%></a></div>
<% if(!create){ %><div class="bao-edit-context"><strong><%=WebSupport.html(s.subjectCode())%></strong><span class="status-badge <%=s.status()==SubjectStatus.ACTIVE?"active":"inactive"%>"><%=s.status()==SubjectStatus.ACTIVE?"Đang hoạt động":"Ngừng hoạt động"%></span></div><% } %>
<% if(request.getAttribute("error")!=null){ %><p role="alert"><%=WebSupport.html(request.getAttribute("error"))%></p><% } %>
<form class="bao-focused-form" method="post" action="<%=base%>"><input type="hidden" name="csrf" value="<%=token%>"><input type="hidden" name="action" value="<%=create?"create":"update"%>"><% if(!create){ %><input type="hidden" name="id" value="<%=s.subjectId()%>"><% } %>
<section class="bao-card"><h2>Thông tin môn học</h2><div class="form-grid"><label>Mã môn học <input name="subjectCode" maxlength="30" required value="<%=WebSupport.html(code)%>" <%=create?"":"readonly"%>></label><label>Tên môn học <input name="subjectName" maxlength="150" required value="<%=WebSupport.html(name)%>"></label></div><label>Mô tả <textarea name="description" rows="4"><%=WebSupport.html(description)%></textarea></label>
</section>
<% if(create){String selected=request.getParameter("initialStatus");if(selected==null)selected="ACTIVE"; %><section class="bao-card bao-create-responsibilities"><h2>Phân công ban đầu</h2><label>Trạng thái ban đầu <select name="initialStatus" required><option value="ACTIVE" <%="ACTIVE".equals(selected)?"selected":""%>>Hoạt động</option><option value="INACTIVE" <%="INACTIVE".equals(selected)?"selected":""%>>Ngừng hoạt động</option></select></label>
<div class="expert-grid"><fieldset><legend>Chuyên gia chính (bắt buộc 1–2)</legend><% for(var e:eligible){ %><label class="check"><input type="checkbox" name="primaryExperts" value="<%=e.userId()%>" <%=primary.contains(e.userId())?"checked":""%>><span><strong><%=WebSupport.html(e.fullName())%></strong><br><small><%=WebSupport.html(e.email())%></small></span></label><% } %></fieldset><fieldset><legend>Chuyên gia hỗ trợ (tối đa 2)</legend><% for(var e:eligible){ %><label class="check"><input type="checkbox" name="supportingExperts" value="<%=e.userId()%>" <%=supporting.contains(e.userId())?"checked":""%>><span><strong><%=WebSupport.html(e.fullName())%></strong><br><small><%=WebSupport.html(e.email())%></small></span></label><% } %></fieldset></div>
</section><% }else{ %><section class="bao-card bao-edit-experts"><h2>Phân công hiện tại</h2><p>Chuyên gia chính: <% if(details.primaryExperts().isEmpty()){ %>Chưa có<% }for(var e:details.primaryExperts()){ %><strong><%=WebSupport.html(e.fullName())%></strong> <% } %></p><p>Chuyên gia hỗ trợ: <% if(details.supportingExperts().isEmpty()){ %>Không có<% }for(var e:details.supportingExperts()){ %><strong><%=WebSupport.html(e.fullName())%></strong> <% } %></p><p><a href="<%=base%>?mode=experts&amp;id=<%=s.subjectId()%>">Mở chức năng phân công chuyên gia</a></p></section><p class="muted">Trạng thái được thay đổi trong chức năng UC16 riêng.</p><% } %>
<div class="form-actions"><button class="primary-button"><%=create?"Tạo môn học":"Lưu thay đổi"%></button><a class="secondary-button" href="<%=create?base:base+"?mode=view&id="+s.subjectId()%>">Hủy</a></div></form>
</main></div><script>document.querySelectorAll('[name=primaryExperts]').forEach(p=>p.addEventListener('change',()=>{if(p.checked){const s=document.querySelector('[name=supportingExperts][value="'+p.value+'"]');if(s)s.checked=false}}));document.querySelectorAll('[name=supportingExperts]').forEach(s=>s.addEventListener('change',()=>{if(s.checked){const p=document.querySelector('[name=primaryExperts][value="'+s.value+'"]');if(p)p.checked=false}}));</script></body></html>
