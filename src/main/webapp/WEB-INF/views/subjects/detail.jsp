<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,java.time.*,java.time.format.*,vn.edu.fpt.ams.dto.*,vn.edu.fpt.ams.model.*,vn.edu.fpt.ams.util.WebSupport,vn.edu.fpt.ams.util.Vietnamese" %>
<% var details=(SubjectDetailsDTO)request.getAttribute("details");var s=details.subject();String base=request.getContextPath()+"/admin/subjects",token=WebSupport.csrf(request);var date=DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm").withZone(ZoneId.of("Asia/Ho_Chi_Minh")); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết <%=WebSupport.html(s.subjectCode())%> | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body class="admin-users admin-app admin-subjects">
<%@ include file="/WEB-INF/views/admin/shell.jspf" %>
<main class="users-main subject-form">
<p><a class="back-link" href="<%=base%>">← Danh sách môn học</a></p><div class="subject-heading"><div><h1><%=WebSupport.html(s.subjectCode()+" · "+s.subjectName())%></h1><span class="status-badge <%=s.status()==SubjectStatus.ACTIVE?"active":"inactive"%>"><%=Vietnamese.label(s.status())%></span></div><div class="row-actions action-buttons"><a class="secondary-button" href="<%=base%>?mode=edit&amp;id=<%=s.subjectId()%>">Sửa thông tin</a><a class="secondary-button" href="<%=base%>?mode=experts&amp;id=<%=s.subjectId()%>">Phân công chuyên gia</a><a class="secondary-button" href="<%=base%>?mode=term&amp;id=<%=s.subjectId()%>">Mở theo học kỳ</a><a class="<%=s.status()==SubjectStatus.ACTIVE?"destructive-button":"secondary-button"%>" href="<%=base%>?mode=status&amp;id=<%=s.subjectId()%>">Đổi trạng thái</a></div></div>
<% if(session.getAttribute("notice")!=null){ %><p role="status"><%=WebSupport.html(Vietnamese.label(session.getAttribute("notice")))%></p><% session.removeAttribute("notice"); } %>
<section><h2>Thông tin môn học</h2><dl class="details-grid"><div><dt>Mã môn học</dt><dd><%=WebSupport.html(s.subjectCode())%></dd></div><div><dt>Tên môn học</dt><dd><%=WebSupport.html(s.subjectName())%></dd></div><div><dt>Trạng thái</dt><dd><%=Vietnamese.label(s.status())%></dd></div><div class="wide"><dt>Mô tả</dt><dd><%=s.description()==null?"Không có":WebSupport.html(s.description())%></dd></div></dl></section>
<section><h2>Chuyên gia phụ trách</h2><div class="expert-grid"><div><h3>Chuyên gia chính</h3><% if(details.primaryExperts().isEmpty()){ %><p class="muted">Chưa phân công.</p><% }for(var e:details.primaryExperts()){ %><p><strong><%=WebSupport.html(e.fullName())%></strong><br><small><%=WebSupport.html(e.email())%></small></p><% } %></div><div><h3>Chuyên gia hỗ trợ</h3><% if(details.supportingExperts().isEmpty()){ %><p class="muted">Không có.</p><% }for(var e:details.supportingExperts()){ %><p><strong><%=WebSupport.html(e.fullName())%></strong><br><small><%=WebSupport.html(e.email())%></small></p><% } %></div></div></section>
<section><h2>Cấu hình học kỳ</h2><div class="users-table-wrap"><table><thead><tr><th>Học kỳ</th><th>Mở đăng ký</th><th>Đóng đăng ký</th><th>Cho phép</th><th>Trạng thái</th></tr></thead><tbody><% for(var term:details.subjectTerms()){ %><tr><td><%=WebSupport.html(term.termCode()+" · "+term.termName())%></td><td><%=date.format(term.registrationOpensAt())%></td><td><%=date.format(term.registrationClosesAt())%></td><td><%=term.registrationEnabled()?"Có":"Không"%></td><td><%=WebSupport.html(term.registrationStatus())%></td></tr><% }if(details.subjectTerms().isEmpty()){ %><tr><td colspan="5" class="empty-state">Môn học chưa được mở trong học kỳ nào.</td></tr><% } %></tbody></table></div></section>
</main></div></body></html>
