<%@ page contentType="text/html;charset=UTF-8" import="vn.edu.fpt.ams.model.*,vn.edu.fpt.ams.util.WebSupport,java.time.*" %>
<% String mode=(String)request.getAttribute("mode"); AcademicTerm term=(AcademicTerm)request.getAttribute("term"); AcademicTerm submitted=(AcademicTerm)request.getAttribute("submittedTerm"); AcademicTerm shown=submitted!=null?submitted:term; boolean view="view".equals(mode); ZoneId zone=ZoneOffset.UTC; String token=WebSupport.csrf(request); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết học kỳ | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"><%@ include file="/WEB-INF/views/shared/assets.jspf" %></head><body class="admin-users admin-app admin-settings ams-ui">
<%@ include file="/WEB-INF/views/admin/shell.jspf" %>
<main class="users-main subject-form ams-content" id="page-content">
<p><a class="back-link" href="${pageContext.request.contextPath}/admin/settings">← Danh sách thiết lập</a></p>
<nav aria-label="Loại thiết lập" class="settings-tabs"><a href="${pageContext.request.contextPath}/admin/settings?tab=terms" aria-current="page">Học kỳ</a><a href="${pageContext.request.contextPath}/admin/settings?tab=subjects">Môn học</a></nav>
<div class="subject-heading"><div><h1><%="create".equals(mode)?"Tạo học kỳ":view?"Chi tiết học kỳ":"Cập nhật học kỳ"%></h1><p class="muted">Tối đa một học kỳ hoạt động và một học kỳ hiện tại. Học kỳ hiện tại phải hoạt động.</p></div><% if(view){ %><a class="primary-button" href="${pageContext.request.contextPath}/admin/master-data?mode=edit&id=<%=term.termId()%>">Sửa</a><% } %></div>
<% if(request.getAttribute("error")!=null){ %><p role="alert"><%=WebSupport.html(request.getAttribute("error"))%></p><% } %><% if("1".equals(request.getParameter("saved"))){ %><p role="status">Đã lưu học kỳ.</p><% } %>
<% if(view){ %><dl class="details-grid"><div><dt>Mã</dt><dd><%=WebSupport.html(term.termCode())%></dd></div><div><dt>Tên</dt><dd><%=WebSupport.html(term.termName())%></dd></div><div><dt>Bắt đầu</dt><dd><%=term.startsAt().atZone(zone).toLocalDate()%></dd></div><div><dt>Kết thúc</dt><dd><%=term.endsAt().atZone(zone).toLocalDate()%></dd></div><div><dt>Hiện tại</dt><dd><span class="term-current-badge <%=term.current()?"current":""%>"><%=term.current()?"Học kỳ hiện tại":"Không"%></span></dd></div><div><dt>Trạng thái</dt><dd><span class="status-badge <%=term.active()?"active":"inactive"%>"><%=term.active()?"Hoạt động":"Ngừng hoạt động"%></span></dd></div></dl>
<% } else { %><form method="post" action="${pageContext.request.contextPath}/admin/master-data"><input type="hidden" name="csrf" value="<%=token%>"><input type="hidden" name="action" value="<%="create".equals(mode)?"create":"update"%>"><% if(shown!=null&&shown.termId()>0){ %><input type="hidden" name="termId" value="<%=shown.termId()%>"><% } %><div class="form-grid"><label>Mã học kỳ<input name="termCode" maxlength="20" required value="<%=shown==null?"":WebSupport.html(shown.termCode())%>"></label><label>Tên học kỳ<input name="termName" maxlength="100" required value="<%=shown==null?"":WebSupport.html(shown.termName())%>"></label><label>Ngày bắt đầu<input type="date" name="startsAt" required value="<%=shown==null||shown.startsAt()==null?"":shown.startsAt().atZone(zone).toLocalDate()%>"></label><label>Ngày kết thúc<input type="date" name="endsAt" required value="<%=shown==null||shown.endsAt()==null?"":shown.endsAt().atZone(zone).toLocalDate()%>"></label></div><% if("create".equals(mode)){ %><label class="check"><input type="checkbox" name="active" <%=shown==null||shown.active()?"checked":""%>> Hoạt động</label><label class="check"><input type="checkbox" name="current" <%=shown!=null&&shown.current()?"checked":""%>> Đặt làm học kỳ hiện tại</label><% } else { if(shown!=null&&shown.active()){ %><input type="hidden" name="active" value="true"><% } if(shown!=null&&shown.current()){ %><input type="hidden" name="current" value="true"><% } } %><div class="form-actions"><button class="primary-button">Lưu học kỳ</button><a class="secondary-button" href="${pageContext.request.contextPath}/admin/settings">Hủy</a></div></form><% } %>
</main></div></body></html>
