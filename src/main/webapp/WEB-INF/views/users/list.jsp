<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,java.time.*,java.time.format.*,vn.edu.fpt.ams.model.*,vn.edu.fpt.ams.util.WebSupport,vn.edu.fpt.ams.util.Vietnamese" %>
<% var users=(List<UserAccount>)request.getAttribute("users"); var reasons=(Map<Long,List<String>>)request.getAttribute("reviewReasons"); int number=(Integer)request.getAttribute("page"); long total=(Long)request.getAttribute("total"), pages=Math.max(1,(total+19)/20); String base=request.getContextPath()+"/admin/users", token=WebSupport.csrf(request); var date=DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm").withZone(ZoneId.of("Asia/Ho_Chi_Minh")); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Danh sách tài khoản | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body class="admin-users">
<header class="admin-top"><a href="${pageContext.request.contextPath}/admin/dashboard">AMS · Quản trị hệ thống</a><form method="post" action="${pageContext.request.contextPath}/auth/signout"><span>Quản trị viên</span><input type="hidden" name="csrf" value="<%=token%>"><button>Đăng xuất</button></form></header>
<div class="admin-layout"><aside class="admin-sidebar"><nav aria-label="Điều hướng quản trị"><a href="${pageContext.request.contextPath}/admin/dashboard">Bảng điều khiển</a><a href="${pageContext.request.contextPath}/admin/settings">Cài đặt</a><a href="<%=base%>" aria-current="page">Tài khoản</a></nav></aside><main class="users-main">
<h1>Danh sách tài khoản</h1><p class="muted">Quản trị viên, chuyên gia và giảng viên dùng tài khoản nội bộ. Sinh viên đăng nhập bằng Google.</p>
<% if(session.getAttribute("notice")!=null){ %><p role="status"><%=WebSupport.html(Vietnamese.label(session.getAttribute("notice")))%></p><% session.removeAttribute("notice"); } %>
<div class="users-toolbar"><form method="get" id="user-filters"><label><span class="sr-only">Tên hoặc email</span><input name="keyword" maxlength="50" placeholder="Tìm theo tên hoặc email…" value="<%=WebSupport.html(request.getParameter("keyword"))%>"></label><label><span class="sr-only">Vai trò</span><select name="role"><option value="">Tất cả vai trò</option><% for(var role:UserRole.values()){ %><option value="<%=role.name()%>" <%=role.name().equals(request.getParameter("role"))?"selected":""%>><%=Vietnamese.label(role)%></option><% } %></select></label><label><span class="sr-only">Trạng thái</span><select name="status"><option value="">Tất cả trạng thái</option><% for(var status:AccountStatus.values()){ %><option value="<%=status.name()%>" <%=status.name().equals(request.getParameter("status"))?"selected":""%>><%=Vietnamese.label(status)%></option><% } %></select></label><button>Tìm kiếm</button></form><a class="primary-button" href="<%=base%>?mode=create">+ Thêm tài khoản</a></div>
<div class="users-table-wrap"><table><thead><tr><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Đăng nhập</th><th>Trạng thái</th><th>Thao tác</th><th>Đăng nhập gần nhất</th><th>Cảnh báo cần xem xét</th></tr></thead><tbody>
<% for(var u:users){ boolean active=u.accountStatus()==AccountStatus.ACTIVE; %><tr><td><a href="<%=base%>?mode=view&amp;id=<%=u.userId()%>"><%=WebSupport.html(u.fullName())%></a></td><td><%=WebSupport.html(u.email())%></td><td><%=Vietnamese.label(u.role())%></td><td><%=u.role()==UserRole.STUDENT?"Google":"Nội bộ"%></td><td><span class="status-badge <%=active?"active":"inactive"%>"><%=Vietnamese.label(u.accountStatus())%></span></td><td><div class="row-actions"><a href="<%=base%>?mode=edit&amp;id=<%=u.userId()%>">Sửa</a><% if(u.userId()!=WebSupport.actor(request)){ %><form method="post" action="<%=base%>" class="status-action" data-confirm="<%=active?"Vô hiệu hóa tài khoản này? Các phân công và đề nghị liên quan sẽ được kiểm tra.":"Kích hoạt lại tài khoản này? Các phân công cũ không tự khôi phục."%>"><input type="hidden" name="csrf" value="<%=token%>"><input type="hidden" name="id" value="<%=u.userId()%>"><input type="hidden" name="action" value="status"><input type="hidden" name="returnTo" value="list"><input type="hidden" name="status" value="<%=active?"INACTIVE":"ACTIVE"%>"><button><%=active?"Vô hiệu hóa":"Kích hoạt"%></button></form><% } %></div></td><td><%=u.lastLoginAt()==null?"Chưa từng đăng nhập":date.format(u.lastLoginAt())%></td><td><% var alerts=reasons.getOrDefault(u.userId(),List.of()); if(alerts.isEmpty()){ %><span class="muted">Không có cảnh báo</span><% } else { %><details><summary>Cần xem xét (<%=alerts.size()%>)</summary><% for(String reason:alerts){ %><p><%=WebSupport.html(Vietnamese.label(reason))%></p><% } %></details><% } %></td></tr><% } %>
<% if(users.isEmpty()){ %><tr><td colspan="8" class="empty-state">Không có tài khoản phù hợp.</td></tr><% } %></tbody></table></div>
<div class="users-footer"><p>Hiển thị <%=users.isEmpty()?0:(number-1)*20+1%>–<%=users.isEmpty()?0:(number-1)*20+users.size()%> trong <%=total%> tài khoản · 20 tài khoản mỗi trang</p><form method="get" class="pagination" aria-label="Phân trang"><input type="hidden" name="keyword" value="<%=WebSupport.html(request.getParameter("keyword"))%>"><input type="hidden" name="role" value="<%=WebSupport.html(request.getParameter("role"))%>"><input type="hidden" name="status" value="<%=WebSupport.html(request.getParameter("status"))%>"><% if(number>1){ %><button name="page" value="<%=number-1%>">Trước</button><% } for(long n=Math.max(1,number-2);n<=Math.min(pages,number+2);n++){ %><button name="page" value="<%=n%>" <%=n==number?"aria-current=\"page\"":""%>><%=n%></button><% } if(number<pages){ %><button name="page" value="<%=number+1%>">Sau</button><% } %></form></div>
<p class="muted review-note">Cảnh báo giúp quản trị viên xem xét và không tự động vô hiệu hóa tài khoản. Thời gian hiển thị theo giờ Việt Nam.</p>
</main></div><script>
const filters=document.getElementById('user-filters');let timer;const search=filters.elements.keyword;const saved=sessionStorage.getItem('ams-user-search-focus');if(saved!==null){search.focus();search.setSelectionRange(search.value.length,search.value.length);sessionStorage.removeItem('ams-user-search-focus');}search.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{sessionStorage.setItem('ams-user-search-focus','1');filters.requestSubmit();},650);});filters.querySelectorAll('select').forEach(s=>s.addEventListener('change',()=>filters.requestSubmit()));document.querySelectorAll('.status-action').forEach(f=>f.addEventListener('submit',e=>{if(!confirm(f.dataset.confirm))e.preventDefault();}));
</script></body></html>
