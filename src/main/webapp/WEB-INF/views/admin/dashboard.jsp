<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,vn.edu.fpt.ams.util.WebSupport" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Bảng điều khiển quản trị | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body><main><%@ include file="../auth/session-nav.jspf" %><h1>Bảng điều khiển quản trị</h1><p>Học kỳ hiện tại: <%=WebSupport.html(vn.edu.fpt.ams.util.Vietnamese.label(request.getAttribute("currentTerm")))%></p><nav><a href="${pageContext.request.contextPath}/admin/users">Tài khoản</a> · <a href="${pageContext.request.contextPath}/admin/settings">Cài đặt</a></nav><table><tr><th>Chỉ số</th><th>Số lượng</th></tr><% for(var entry:((Map<String,Long>)request.getAttribute("summary")).entrySet()){ %><tr><td><%=WebSupport.html(vn.edu.fpt.ams.util.Vietnamese.label(entry.getKey()))%></td><td><%=entry.getValue()%></td></tr><% } %></table></main></body></html>
