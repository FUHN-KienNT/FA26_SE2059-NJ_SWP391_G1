<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html lang="vi"><head><title>Chi tiết lớp học | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body><main>
