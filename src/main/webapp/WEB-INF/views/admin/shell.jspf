<%@ page pageEncoding="UTF-8" %>
<%
Object baoForward = request.getAttribute("jakarta.servlet.forward.servlet_path");
String baoPath = baoForward instanceof String ? (String)baoForward : request.getServletPath();
boolean baoSubjects = "/admin/subjects".equals(baoPath);
boolean baoTerms = "/admin/terms".equals(baoPath) || "/admin/master-data".equals(baoPath);
boolean baoSettings = "/admin/settings".equals(baoPath);
%>
<a class="ams-skip" href="#page-content">Đến nội dung chính</a>
<header class="ams-header ams-admin-header">
<button class="ams-menu-toggle" type="button" aria-controls="ams-navigation" aria-expanded="true" aria-label="Ẩn hoặc hiện menu">☰</button>
<a class="ams-brand" href="${pageContext.request.contextPath}/home"><span class="ams-logo" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m2 8 10-5 10 5-10 5-10-5Z"/><path d="M6 10v6c4 3 8 3 12 0v-6M22 8v8"/></svg></span><strong>AMS</strong><span>Hệ thống quản lý bài tập</span></a>
<form class="ams-account" method="post" action="${pageContext.request.contextPath}/auth/signout"><span>Quản trị viên</span><input type="hidden" name="csrf" value="<%=vn.edu.fpt.ams.util.WebSupport.csrf(request)%>"><button type="submit">Đăng xuất</button></form>
</header>
<div class="ams-layout ams-admin-layout">
<aside class="ams-sidebar ams-admin-sidebar" id="ams-navigation"><nav aria-label="Điều hướng quản trị">
<a href="${pageContext.request.contextPath}/admin/dashboard" <%="/admin/dashboard".equals(baoPath)?"aria-current=\"page\"":""%>><svg width="18" height="18" class="bao-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m3 10 9-7 9 7v10h-6v-7H9v7H3Z"/></svg>Bảng điều khiển</a>
<a href="${pageContext.request.contextPath}/admin/users" <%="/admin/users".equals(baoPath)?"aria-current=\"page\"":""%>><svg width="18" height="18" class="bao-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>Tài khoản</a>
<a href="${pageContext.request.contextPath}/admin/terms" <%=baoTerms?"aria-current=\"page\"":""%>><svg width="18" height="18" class="bao-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/></svg>Học kỳ</a>
<a href="${pageContext.request.contextPath}/admin/subjects" <%=baoSubjects?"aria-current=\"page\"":""%>><svg width="18" height="18" class="bao-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Z"/><path d="M12 5v15"/></svg>Môn học</a>
<a href="${pageContext.request.contextPath}/admin/settings" <%=baoSettings?"aria-current=\"page\"":""%>><svg width="18" height="18" class="bao-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m9 3-1 3-3 1-2 3 2 2-1 3 2 3 3-1 2 3h3l1-3 3-1 2-3-2-2 1-3-2-3-3 1-2-3Z"/><circle cx="12" cy="12" r="3"/></svg>Cài đặt hệ thống</a>
</nav></aside>