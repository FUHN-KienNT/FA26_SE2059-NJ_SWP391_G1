<%@ page contentType="text/html;charset=UTF-8" import="vn.edu.fpt.ams.dto.*,vn.edu.fpt.ams.model.*,vn.edu.fpt.ams.util.WebSupport,vn.edu.fpt.ams.util.Vietnamese" %>
<% var details=(SubjectDetailsDTO)request.getAttribute("details");var s=details.subject();var target=s.status()==SubjectStatus.ACTIVE?SubjectStatus.INACTIVE:SubjectStatus.ACTIVE;String base=request.getContextPath()+"/admin/subjects",token=WebSupport.csrf(request); %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trạng thái môn học | AMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head><body class="admin-users admin-subjects">
<header class="admin-top"><a href="${pageContext.request.contextPath}/admin/dashboard">AMS · Quản trị hệ thống</a><form method="post" action="${pageContext.request.contextPath}/auth/signout"><span>Quản trị viên</span><input type="hidden" name="csrf" value="<%=token%>"><button>Đăng xuất</button></form></header>
<div class="admin-layout"><aside class="admin-sidebar"><nav><a href="${pageContext.request.contextPath}/admin/dashboard">Bảng điều khiển</a><a href="${pageContext.request.contextPath}/admin/users">Tài khoản</a><a href="<%=base%>" aria-current="page">Môn học</a><a href="${pageContext.request.contextPath}/admin/settings">Cài đặt</a></nav></aside><main class="users-main subject-form">
<p><a href="<%=base%>?mode=view&amp;id=<%=s.subjectId()%>">← Chi tiết môn học</a></p><h1>UC16 · Kích hoạt / Ngừng hoạt động</h1><p><strong><%=WebSupport.html(s.subjectCode()+" · "+s.subjectName())%></strong></p>
<% if(request.getAttribute("error")!=null){ %><p role="alert"><%=WebSupport.html(request.getAttribute("error"))%></p><% } %>
<dl class="details-grid"><div><dt>Trạng thái hiện tại</dt><dd><%=Vietnamese.label(s.status())%></dd></div><div><dt>Trạng thái mới</dt><dd><%=Vietnamese.label(target)%></dd></div><div><dt>Chuyên gia chính</dt><dd><%=details.primaryExperts().size()%></dd></div><div><dt>Chuyên gia hỗ trợ</dt><dd><%=details.supportingExperts().size()%></dd></div></dl>
<% if(target==SubjectStatus.INACTIVE){ %><p class="muted">Ngừng hoạt động sẽ đóng đăng ký mới của các cấu hình học kỳ. Dữ liệu lịch sử không bị xóa.</p><% }else{ %><p class="muted">Kích hoạt yêu cầu 1–2 chuyên gia chính đang hoạt động và tối đa 2 chuyên gia hỗ trợ.</p><% } %>
<form method="post" action="<%=base%>" data-confirm="Xác nhận thay đổi trạng thái môn học?"><input type="hidden" name="csrf" value="<%=token%>"><input type="hidden" name="action" value="status"><input type="hidden" name="id" value="<%=s.subjectId()%>"><input type="hidden" name="status" value="<%=target%>"><button class="primary-button"><%=target==SubjectStatus.ACTIVE?"Kích hoạt":"Ngừng hoạt động"%></button></form>
</main></div><script>document.querySelector('[data-confirm]').addEventListener('submit',e=>{if(!confirm(e.currentTarget.dataset.confirm))e.preventDefault()});</script></body></html>
